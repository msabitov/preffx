{
    "name": "preffx",
    "version": "0.8.0",
    "description": "Self-confident DOM reactivity",
    "author": "Marat Sabitov",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "test": "vitest",
        "test:node": "vitest --project node",
        "test:node:run": "vitest run --project node",
        "coverage": "vitest run --coverage",
        "coverage:submit": "vitest run --coverage && coveralls < ./coverage/lcov.info"
    },
    "keywords": [
        "preffx",
        "preact",
        "signals",
        "ui",
        "user interface",
        "front-end",
        "framework"
    ],
    "types": "./dist/types/index.d.ts",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        },
        "./jsx-runtime": {
            "types": "./dist/types/jsx-runtime.d.ts",
            "import": "./dist/jsx-runtime.js"
        },
        "./jsx-dev-runtime": {
            "types": "./dist/types/jsx-dev-runtime.d.ts",
            "import": "./dist/jsx-dev-runtime.js"
        },
        "./server": {
            "types": "./dist/types/server/index.d.ts",
            "import": "./dist/server.js"
        },
        "./state": {
            "types": "./dist/types/state.d.ts",
            "import": "./dist/state.js"
        }
    },
    "dependencies": {
        "@preact/signals-core": "^1.14.4"
    },
    "devDependencies": {
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@vitest/browser-playwright": "^4.1.8",
        "@vitest/coverage-v8": "^4.1.11",
        "coveralls": "^3.1.1",
        "rollup": "^4.59.0",
        "rollup-plugin-cleaner": "^1.0.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.0"
    },
    "files": [
        "LICENSE",
        "README.md",
        "package.json",
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/msabitov/preffx"
    },
    "homepage": "https://effnd.tech/preffx/"
}
